{
  "compilerOptions": {
    "target": "esnext",
    "noUnusedParameters": false,
    "strict": true,
    "types": ["@bentley/studio-cli", "jest", "@testing-library/jest-dom"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
